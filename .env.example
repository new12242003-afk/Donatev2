# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง
PORT=3000
# production = โหมดเว็บจริง (บังคับ SESSION_SECRET, cookie https)
NODE_ENV=development
# โฟลเดอร์เก็บฐานข้อมูล + ไฟล์อัปโหลด (บน Railway = path ของ Volume เช่น /data) — เว้นว่าง = โฟลเดอร์โปรเจกต์
DATA_DIR=
# รหัสผ่านบัญชี admin ตอนสร้างครั้งแรก (เว้นว่าง: เครื่องตัวเอง = admin123 / production = สุ่มแล้วแสดงใน log)
ADMIN_PASSWORD=
BASE_URL=http://localhost:3000
SESSION_SECRET=เปลี่ยนเป็นสตริงสุ่มยาว ๆ
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com

# ---------- การยืนยันอีเมล (เลือกอย่างใดอย่างหนึ่ง) ----------
# แบบ A: Gmail (ต้องสร้าง App Password จากบัญชี Google ที่เปิด 2FA)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=Donate Stream <youraddress@gmail.com>

# แบบ B: SMTP ทั่วไป (ถ้าใช้ ให้ลบค่า GMAIL_* ออก)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------- เข้าสู่ระบบด้วย Google (ไม่บังคับ) ----------
# สร้าง OAuth Client (Web) ที่ https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# หมายเหตุ: ถ้าไม่ตั้งค่าอีเมล ระบบจะแสดง "ลิงก์ยืนยัน" บนหน้าเว็บ/คอนโซลให้กดทดสอบได้เลย

# ---------- AI เสียงพูดข้อความโดเนท (ไม่บังคับ) ----------
# เปิด "Cloud Text-to-Speech API" ใน Google Cloud แล้วสร้าง API key ที่ https://console.cloud.google.com/apis/credentials
# (แนะนำจำกัด key ให้ใช้ได้เฉพาะ Cloud Text-to-Speech API) — ไม่ตั้งค่า = ใช้เสียงของเบราว์เซอร์ใน OBS แทน
GOOGLE_TTS_API_KEY=

# ---------- ค่าแพลนของสตรีมเมอร์: QR พร้อมเพย์ของเว็บ ----------
# ปกติไม่ต้องตั้ง: ค่าแพลนโอนเข้า QR รับเงินของบัญชีแอดมิน (ล็อกอินแอดมิน → แดชบอร์ด → หน้าโดเนท & QR รับเงิน)
# ตั้งค่านี้เมื่ออยากใช้พร้อมเพย์อื่นแทน — เบอร์มือถือ 10 หลัก / เลขบัตรประชาชน 13 หลัก / e-Wallet ID 15 หลัก
PROMPTPAY_ID=
# ชื่อบัญชีที่แสดงใต้ QR ให้ผู้ใช้เช็คก่อนโอน (ควรตรงกับที่แอปธนาคารแสดงตอนสแกน)
PROMPTPAY_NAME=
# เลขบัญชีธนาคารที่ผูกกับพร้อมเพย์ (ตัวเลขล้วน) — สลิปบางธนาคารแสดงเลขบัญชีผู้รับแทนเบอร์พร้อมเพย์ ใช้เทียบว่าเงินเข้าบัญชีเรา
PAYMENT_BANK_ACCOUNT=

# ---------- ตรวจสลิปกับธนาคารอัตโนมัติ (ค่าแพลน + โดเนทผ่าน QR สตรีมเมอร์) ----------
# ใส่ key ของเจ้าใดเจ้าหนึ่ง (มีทั้งคู่ = ใช้ Slip2Go)
# Slip2Go: สมัครที่ https://slip2go.com → เมนู API Connect → คัดลอก Secret Key
SLIP2GO_API_KEY=
# EasySlip: https://developer.easyslip.com
EASYSLIP_API_KEY=
# ไม่ตั้งเลย = สลิปค่าแพลนรอแอดมินตรวจ / สลิปโดเนทรอสตรีมเมอร์กดยืนยันเอง

# แสดงรหัส/ลิงก์ยืนยันอีเมลบนหน้าเว็บเมื่อยังไม่ได้ตั้งค่าอีเมล (บนเว็บจริงควรตั้ง Gmail/SMTP แล้วปิด)
# SHOW_DEV_CODES=false
